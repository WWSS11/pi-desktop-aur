# Prebuilt PI-Desktop. The package is produced by this repository's GitHub
# Actions workflow: it builds pi-desktop-git from upstream `main` inside an Arch
# container and republishes the resulting package as pi-desktop-bin.
#
# pkgver/source/sha256sums are bumped automatically by CI on every upstream
# commit; do not edit them by hand.

pkgname=pi-desktop-bin
pkgver=0.17.0.r4712.g72b5e82
pkgrel=1
pkgdesc="Local-first AI coding agent desktop: Electron UI and Rust host core (prebuilt)"
arch=('x86_64')
url="https://github.com/WWSS11/pi-desktop-aur"
license=('LGPL-3.0-only')
depends=(
  'gtk3'
  'nss'
  'libxss'
  'libxtst'
  'libnotify'
  'libsecret'
  'libayatana-appindicator'
  'at-spi2-core'
  'xdg-utils'
  'hicolor-icon-theme'
  'libpulse'
  'libdrm'
  'mesa'
  'libxkbcommon'
  'libxcomposite'
  'libxdamage'
  'libxrandr'
  'libxshmfence'
  'libglvnd'
  'libjpeg-turbo'
  'libxml2'
  'libxslt'
  'minizip'
  'opus'
  'flac'
  'libevent'
  'c-ares'
  'brotli'
)
conflicts=('pi-desktop' 'pi-desktop-git')
provides=('pi-desktop')
source=("https://github.com/WWSS11/pi-desktop-aur/releases/download/v0.17.0.r4712.g72b5e82/pi-desktop-git-0.17.0.r4712.g72b5e82-1-x86_64.pkg.tar.zst")
sha256sums=('5cce7761d24cccb0f94389f3f3365eff1408e04fc0d18a83fb856acd0ef0e2cd')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" opt usr
  ln -s pi-desktop-git "$pkgdir/usr/share/licenses/$pkgname"
}
